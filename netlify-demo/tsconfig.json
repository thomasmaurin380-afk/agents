{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "next/link": ["./src/shims/next-link.tsx"],
      "next/navigation": ["./src/shims/next-navigation.ts"],
      "@/components/layout/interface-mode": ["./src/interface-mode-demo.tsx"],
      "@/app/(auth)/actions": ["./src/shims/auth-actions.ts"],
      "@/*": ["../*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "lucide-react": ["./node_modules/lucide-react"],
      "clsx": ["./node_modules/clsx"],
      "tailwind-merge": ["./node_modules/tailwind-merge"],
      "class-variance-authority": ["./node_modules/class-variance-authority"],
      "next-themes": ["./node_modules/next-themes"]
    }
  },
  "include": ["src", "vite.config.ts"]
}

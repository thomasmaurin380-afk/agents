# Copier en .env.local et compléter. Ne jamais committer de secret.

# development | test | production
APP_ENV=development
# URL publique de l'application (liens d'invitation)
APP_URL=http://127.0.0.1:3000

# Connexion PostgreSQL utilisée par l'application (serveur uniquement).
# Supabase : chaîne « Transaction pooler » (port 6543) du projet, région eu-west-3.
# Local (npx supabase start) : postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé d'administration : serveur uniquement (création de comptes à l'acceptation d'une invitation, seed).
SUPABASE_SERVICE_ROLE_KEY=

# 2FA obligatoire pour les utilisateurs du cabinet (D-15). Ne jamais désactiver en production.
REQUIRE_STAFF_MFA=true
